<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="HoverTranslate.App.Settings.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="HoverTranslate — Настройки">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="28,20,28,28" Spacing="28" MaxWidth="720" HorizontalAlignment="Stretch">
            <StackPanel.Resources>
                <Style x:Key="CaptionStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                    <Setter Property="TextWrapping" Value="Wrap" />
                    <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                </Style>
                <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Padding" Value="8" />
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="MinHeight" Value="0" />
                </Style>
            </StackPanel.Resources>

            <!-- ============================================================ Горячие клавиши -->
            <StackPanel Spacing="12">
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Горячие клавиши" />

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Слово под курсором" />
                        <TextBlock Style="{StaticResource CaptionStyle}" Text="Нажмите кнопку справа, затем сочетание на клавиатуре." />
                    </StackPanel>
                    <Button x:Name="LookupKeyButton" Grid.Column="1" MinWidth="160" Tag="lookup"
                            Click="HotkeyButton_Click" PreviewKeyDown="HotkeyButton_PreviewKeyDown" LostFocus="HotkeyButton_LostFocus" />
                </Grid>

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Перевод выделенной области" />
                        <TextBlock Style="{StaticResource CaptionStyle}" Text="Выделите прямоугольник с текстом — он распознаётся и переводится целиком." />
                    </StackPanel>
                    <Button x:Name="AreaKeyButton" Grid.Column="1" MinWidth="160" Tag="area"
                            Click="HotkeyButton_Click" PreviewKeyDown="HotkeyButton_PreviewKeyDown" LostFocus="HotkeyButton_LostFocus" />
                </Grid>

                <TextBlock x:Name="HotkeyStatus" Style="{StaticResource CaptionStyle}" Visibility="Collapsed" />

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Боковая кнопка мыши 4 (назад)" VerticalAlignment="Center" />
                    <ComboBox x:Name="MouseX1Combo" Grid.Column="1" MinWidth="220" SelectionChanged="MouseX1Combo_SelectionChanged">
                        <ComboBoxItem Content="Слово под курсором" Tag="word" />
                        <ComboBoxItem Content="Перевод предложения" Tag="sentence" />
                        <ComboBoxItem Content="Перевод области" Tag="area" />
                        <ComboBoxItem Content="Не назначать" Tag="none" />
                    </ComboBox>
                </Grid>

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Боковая кнопка мыши 5 (вперёд)" VerticalAlignment="Center" />
                    <ComboBox x:Name="MouseX2Combo" Grid.Column="1" MinWidth="220" SelectionChanged="MouseX2Combo_SelectionChanged">
                        <ComboBoxItem Content="Слово под курсором" Tag="word" />
                        <ComboBoxItem Content="Перевод предложения" Tag="sentence" />
                        <ComboBoxItem Content="Перевод области" Tag="area" />
                        <ComboBoxItem Content="Не назначать" Tag="none" />
                    </ComboBox>
                </Grid>
                <TextBlock Style="{StaticResource CaptionStyle}"
                           Text="Назначенная кнопка мыши не доходит до программы под курсором (браузер не уйдёт «назад»)." />
            </StackPanel>

            <!-- ============================================================ Карточка -->
            <StackPanel Spacing="12">
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Карточка" />

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="52" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Размер шрифта" VerticalAlignment="Center" />
                    <Slider x:Name="FontSlider" Grid.Column="1" Width="240" Minimum="80" Maximum="150" StepFrequency="10"
                            TickFrequency="10" TickPlacement="Outside" ValueChanged="FontSlider_ValueChanged" />
                    <TextBlock x:Name="FontValue" Grid.Column="2" VerticalAlignment="Center" TextAlignment="Right" />
                </Grid>

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="52" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Плотность фона" />
                        <TextBlock Style="{StaticResource CaptionStyle}" Text="100 % — сплошной фон; меньше — сквозь карточку виден фон программы." />
                    </StackPanel>
                    <Slider x:Name="OpacitySlider" Grid.Column="1" Width="240" Minimum="60" Maximum="100" StepFrequency="5"
                            TickFrequency="10" TickPlacement="Outside" ValueChanged="OpacitySlider_ValueChanged" />
                    <TextBlock x:Name="OpacityValue" Grid.Column="2" VerticalAlignment="Center" TextAlignment="Right" />
                </Grid>

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Тема" VerticalAlignment="Center" />
                    <ComboBox x:Name="ThemeCombo" Grid.Column="1" MinWidth="220" SelectionChanged="ThemeCombo_SelectionChanged">
                        <ComboBoxItem Content="Как в Windows" Tag="system" />
                        <ComboBoxItem Content="Светлая" Tag="light" />
                        <ComboBoxItem Content="Тёмная" Tag="dark" />
                    </ComboBox>
                </Grid>

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Закрывать автоматически" />
                        <TextBlock Style="{StaticResource CaptionStyle}"
                                   Text="Отсчёт идёт, пока на карточке нет указателя мыши; закреплённая карточка не закрывается." />
                    </StackPanel>
                    <ComboBox x:Name="AutoCloseCombo" Grid.Column="1" MinWidth="220" SelectionChanged="AutoCloseCombo_SelectionChanged">
                        <ComboBoxItem Content="Не закрывать" Tag="0" />
                        <ComboBoxItem Content="Через 5 секунд" Tag="5" />
                        <ComboBoxItem Content="Через 10 секунд" Tag="10" />
                        <ComboBoxItem Content="Через 15 секунд" Tag="15" />
                        <ComboBoxItem Content="Через 30 секунд" Tag="30" />
                        <ComboBoxItem Content="Через минуту" Tag="60" />
                    </ComboBox>
                </Grid>

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Скрывать карточку из снимков экрана" />
                        <TextBlock Style="{StaticResource CaptionStyle}"
                                   Text="Включено: карточка не видна в скриншотах и записи экрана, поэтому распознавание не прочитает её текст вместо текста под ней. Выключите, если хотите снимать карточку." />
                    </StackPanel>
                    <ToggleSwitch x:Name="ExcludeCaptureToggle" Grid.Column="1" MinWidth="0" OnContent="" OffContent=""
                                  Toggled="ExcludeCaptureToggle_Toggled" />
                </Grid>

                <StackPanel Spacing="6">
                    <Button x:Name="SampleButton" Content="Показать пример карточки" Click="SampleButton_Click" />
                    <TextBlock Style="{StaticResource CaptionStyle}"
                               Text="Пример закреплён: меняйте настройки выше и смотрите на результат. Закройте его кнопкой ✕." />
                </StackPanel>
            </StackPanel>

            <!-- ============================================================ Озвучка -->
            <StackPanel Spacing="12">
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Озвучка" />
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Голос" VerticalAlignment="Center" />
                    <ComboBox x:Name="VoiceCombo" Grid.Column="1" MinWidth="260" SelectionChanged="VoiceCombo_SelectionChanged" />
                    <Button x:Name="VoiceTestButton" Grid.Column="2" Content="Проверить" Click="VoiceTestButton_Click" />
                </Grid>
                <TextBlock x:Name="VoiceStatus" Style="{StaticResource CaptionStyle}" Visibility="Collapsed" />
                <HyperlinkButton x:Name="SpeechSettingsLink" Content="Открыть параметры речи Windows" Padding="0"
                                 Visibility="Collapsed" Click="SpeechSettingsLink_Click" />
            </StackPanel>

            <!-- ============================================================ Облачный перевод -->
            <StackPanel Spacing="12">
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Облачный перевод (Gemini)" />
                <TextBlock Style="{StaticResource CaptionStyle}"
                           Text="Необязательно. Предложения и выделенные области переводятся через Google Gemini: звучит естественнее встроенной модели, но нужны интернет и бесплатный ключ. Сначала показывается встроенный перевод, облачный подменяет его, когда придёт. Слова всегда ищутся локально и в облако не отправляются. При ошибке, лимите или без сети остаётся встроенный перевод." />

                <InfoBar IsOpen="True" IsClosable="False" Severity="Warning" Title="Конфиденциальность"
                         Message="Если включить, текст с экрана (предложения и области, которые вы переводите) уходит в Google. На бесплатном уровне Google может использовать запросы для улучшения своих моделей (кроме ЕС, Швейцарии и Великобритании). Не включайте для текста, который нельзя передавать третьим лицам." />

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Переводить предложения через Gemini" />
                        <TextBlock Style="{StaticResource CaptionStyle}" Text="Выключено по умолчанию. Для слов в карточке облачный перевод предложения включается кнопкой «Облако» на ней." />
                    </StackPanel>
                    <ToggleSwitch x:Name="CloudToggle" Grid.Column="1" MinWidth="0" OnContent="" OffContent="" Toggled="CloudToggle_Toggled" />
                </Grid>

                <StackPanel Spacing="6">
                    <TextBlock Text="Ключ Gemini API" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <PasswordBox x:Name="CloudKeyBox" PlaceholderText="Вставьте ключ" PasswordChanged="CloudKeyBox_PasswordChanged" />
                        <Button x:Name="CloudSaveButton" Grid.Column="1" Content="Сохранить" IsEnabled="False" Click="CloudSave_Click" />
                        <Button x:Name="CloudTestButton" Grid.Column="2" Content="Проверить" Click="CloudTest_Click" />
                        <Button x:Name="CloudDeleteButton" Grid.Column="3" Content="Удалить ключ" Click="CloudDelete_Click" />
                    </Grid>
                    <TextBlock x:Name="CloudKeyState" Style="{StaticResource CaptionStyle}" />
                    <TextBlock x:Name="CloudStatus" Style="{StaticResource CaptionStyle}" Visibility="Collapsed" />
                    <HyperlinkButton Content="Получить бесплатный ключ в Google AI Studio" Padding="0" Click="CloudKeyLink_Click" />
                    <TextBlock Style="{StaticResource CaptionStyle}"
                               Text="Ключ хранится только на этом компьютере в зашифрованном виде (защита данных Windows для вашей учётной записи); в файлах и логах открытым текстом его нет." />
                </StackPanel>

                <TextBlock x:Name="CloudUsageText" TextWrapping="Wrap" />

                <Expander Header="Дополнительно" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource CaptionStyle}"
                                   Text="Имя модели Gemini. Имена конкретных версий быстро устаревают, поэтому по умолчанию используется «последняя flash-lite». Если модель недоступна, программа пробует запасную, затем встроенный перевод." />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="CloudModelBox" LostFocus="CloudModelBox_LostFocus" />
                            <Button Grid.Column="1" Content="По умолчанию" Click="CloudModelReset_Click" />
                        </Grid>
                    </StackPanel>
                </Expander>
            </StackPanel>

            <!-- ============================================================ Распознавание текста -->
            <StackPanel Spacing="12">
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Распознавание текста" />

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Запасное распознавание (PaddleOCR)" />
                        <TextBlock x:Name="FallbackOcrHint" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap"
                                   Text="Если Windows плохо прочитал текст (стилизованные шрифты, надписи поверх картинок), он читается ещё раз другим движком. В таких случаях ответ приходит на 0,5–1,5 с позже." />
                    </StackPanel>
                    <ToggleSwitch x:Name="FallbackOcrToggle" Grid.Column="1" MinWidth="0" OnContent="" OffContent="" Toggled="FallbackOcrToggle_Toggled" />
                </Grid>
            </StackPanel>

            <!-- ============================================================ История и кэш -->
            <StackPanel Spacing="12">
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="История и кэш" />

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Записывать историю слов" />
                        <TextBlock Style="{StaticResource CaptionStyle}" Text="Слова, которые вы смотрите, попадают в окно «Словарь». Избранное этим не затрагивается." />
                    </StackPanel>
                    <ToggleSwitch x:Name="HistoryToggle" Grid.Column="1" MinWidth="0" OnContent="" OffContent="" Toggled="HistoryToggle_Toggled" />
                </Grid>

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Кэш переводов предложений" />
                        <TextBlock Style="{StaticResource CaptionStyle}"
                                   Text="Повторный перевод того же предложения берётся из кэша мгновенно. Хранится не больше 20 000 предложений, старые удаляются." />
                    </StackPanel>
                    <ToggleSwitch x:Name="CacheToggle" Grid.Column="1" MinWidth="0" OnContent="" OffContent="" Toggled="CacheToggle_Toggled" />
                </Grid>

                <TextBlock x:Name="StorageText" TextWrapping="Wrap" />

                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button x:Name="ClearHistoryButton" Content="Очистить историю…" Click="ClearHistory_Click" />
                    <Button x:Name="ClearCacheButton" Content="Очистить кэш переводов" Click="ClearCache_Click" />
                </StackPanel>
                <TextBlock x:Name="StorageStatus" Style="{StaticResource CaptionStyle}" Visibility="Collapsed" />
            </StackPanel>

            <!-- ============================================================ Запуск -->
            <StackPanel Spacing="12">
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Запуск" />
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Запускать при входе в Windows" />
                        <TextBlock Style="{StaticResource CaptionStyle}" Text="Программа стартует свёрнутой в трей. Права администратора не нужны." />
                    </StackPanel>
                    <ToggleSwitch x:Name="AutostartToggle" Grid.Column="1" MinWidth="0" OnContent="" OffContent="" Toggled="AutostartToggle_Toggled" />
                </Grid>
                <TextBlock x:Name="AutostartStatus" Style="{StaticResource CaptionStyle}" Visibility="Collapsed" />
            </StackPanel>

            <!-- ============================================================ Исключения -->
            <StackPanel Spacing="12">
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Программы-исключения" />
                <TextBlock Style="{StaticResource CaptionStyle}"
                           Text="Пока такая программа в фокусе, горячие клавиши и боковые кнопки мыши не перехватываются и работают в ней как обычно (например, в игре, где Alt+Q — свой приём)." />

                <ItemsControl x:Name="ExclusionsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Grid ColumnSpacing="8" Padding="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind}" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}" Click="RemoveExclusion_Click"
                                        ToolTipService.ToolTip="Убрать из списка">
                                    <FontIcon Glyph="&#xE711;" FontSize="12" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="ExclusionsEmpty" Text="Список пуст." Style="{StaticResource CaptionStyle}" />

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ExclusionBox" PlaceholderText="Имя программы, например game.exe" KeyDown="ExclusionBox_KeyDown" />
                    <Button Grid.Column="1" Content="Добавить" Click="AddExclusion_Click" />
                    <DropDownButton Grid.Column="2" Content="Из запущенных">
                        <DropDownButton.Flyout>
                            <MenuFlyout x:Name="RunningFlyout" Opening="RunningFlyout_Opening" />
                        </DropDownButton.Flyout>
                    </DropDownButton>
                </Grid>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Window>
