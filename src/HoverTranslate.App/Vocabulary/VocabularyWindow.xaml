<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="HoverTranslate.App.Vocabulary.VocabularyWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:HoverTranslate.App.Vocabulary"
    Title="HoverTranslate — Словарь">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Padding="20,16,20,12" RowSpacing="12">
        <Grid.Resources>
            <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="8" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Вкладки и действия -->
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <SelectorBar x:Name="Tabs" HorizontalAlignment="Left">
                <SelectorBarItem x:Name="HistoryTab" Text="История" IsSelected="True" />
                <SelectorBarItem x:Name="FavoritesTab" Text="Избранное" />
            </SelectorBar>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <DropDownButton Content="Экспорт для Anki"
                                ToolTipService.ToolTip="Слово; перевод; определение; предложение — все записи открытой вкладки">
                    <DropDownButton.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="CSV, разделитель «;» (UTF-8 с BOM)…" Click="ExportCsv_Click" />
                            <MenuFlyoutItem Text="TXT, разделитель — табуляция (UTF-8)…" Click="ExportTxt_Click" />
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
                <Button Content="Очистить…" Click="Clear_Click" />
            </StackPanel>
        </Grid>

        <!-- Поиск и переключатель истории -->
        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" PlaceholderText="Поиск по слову, переводу, определению, предложению" />
            <ToggleSwitch x:Name="HistoryToggle" Grid.Column="1" MinWidth="0" VerticalAlignment="Center"
                          OnContent="Сохранять историю" OffContent="История выключена" />
        </Grid>

        <!-- Список -->
        <Grid Grid.Row="2">
            <ListView x:Name="ResultsList" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:VocabularyRow">
                        <Grid ColumnSpacing="8" Padding="0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock TextWrapping="Wrap" IsTextSelectionEnabled="True">
                                    <Run Text="{x:Bind Title}" FontSize="17" FontWeight="SemiBold" />
                                    <Run Text="{x:Bind TranslationSuffix}" FontSize="15" />
                                </TextBlock>
                                <TextBlock Text="{x:Bind Sentence}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                                           Visibility="{x:Bind SentenceVisibility}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind Meta}" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                <Button Style="{StaticResource IconButtonStyle}" Click="Speak_Click" ToolTipService.ToolTip="Произнести">
                                    <FontIcon Glyph="&#xE767;" FontSize="15" />
                                </Button>
                                <Button Style="{StaticResource IconButtonStyle}" Click="Star_Click" Visibility="{x:Bind StarVisibility}"
                                        ToolTipService.ToolTip="{x:Bind StarTip, Mode=OneWay}">
                                    <FontIcon Glyph="{x:Bind StarGlyph, Mode=OneWay}" FontSize="15" />
                                </Button>
                                <Button Style="{StaticResource IconButtonStyle}" Click="Delete_Click" ToolTipService.ToolTip="Удалить запись">
                                    <FontIcon Glyph="&#xE74D;" FontSize="15" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock x:Name="EmptyText" Visibility="Collapsed" TextWrapping="Wrap" TextAlignment="Center"
                       HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>

        <TextBlock x:Name="StatusText" Grid.Row="3" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
    </Grid>
</Window>
