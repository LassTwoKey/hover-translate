<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="HoverTranslate.App.DebugWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:HoverTranslate.App"
    Title="HoverTranslate — отладка">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Слово под курсором" />
            <TextBlock x:Name="HintText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
        </StackPanel>

        <ListView x:Name="ResultsList" Grid.Row="1" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:OutcomeRow">
                    <StackPanel Padding="0,8" Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock FontSize="18" FontWeight="SemiBold" Text="{x:Bind Word}" IsTextSelectionEnabled="True" />
                            <TextBlock VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Meta}" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind Sentence}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="{x:Bind Note}"
                                   TextWrapping="Wrap" Visibility="{x:Bind NoteVisibility}" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Window>
